rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check roles from Firestore
    function hasRole(role) {
      return request.auth != null && 
        firestore.get(/databases/prestige-box/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStaff() {
      return hasRole('admin') || hasRole('advisor');
    }

    match /clients/{clientId}/{allPaths=**} {
      // Restrict access to staff or the specific user if applicable
      // For now, allow staff to manage client documents
      allow read, write: if isStaff();
    }
    
    // Fallback for user's own profile photos or other assets can be added here
  }
}
