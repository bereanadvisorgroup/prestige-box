{
  "mcpServers": {
    "axiom": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.axiom.co/mcp"]
    },
    "drizzle-mcp": {
      "command": "npx",
      "args": ["-y", "drizzle-orm-mcp"],
      "env": {
        "DRIZZLE_CONFIG_PATH": "./drizzle.config.ts"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "shadcn-mcp": {
      "command": "npx",
      "args": ["-y", "shadcn-ui-mcp"]
    },
    "vercel-mcp": {
      "url": "https://mcp.vercel.com",
      "type": "http"
    }
  }
}
